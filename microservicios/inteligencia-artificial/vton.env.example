# Solo ejecución nativa. En Docker se usan las variables del perfil vton.
CLB_VTON_PESOS=./weights
CLB_VTON_CACHE=./resultados-vton
CLB_VTON_FUENTE=/opt/CatVTON
HF_HOME=./weights
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
U2NET_HOME=./weights/rembg
CLB_IDENTIDAD_EMISOR=http://127.0.0.1:18000/identidad/realms/clb
CLB_IDENTIDAD_INTERNO=http://127.0.0.1:18000/identidad
