# Variables de entorno para el microservicio de Inteligencia Artificial (GraphQL de gestión, Reportes v2, Ollama)

CLB_ENTORNO=produccion
CLB_IA_PUERTO=8000

# Base de datos analítica (PostgreSQL)
CLB_ANALITICA_HOST=localhost
CLB_ANALITICA_PUERTO=5432
CLB_ANALITICA_USUARIO=clb_analitica
CLB_ANALITICA_CLAVE=
CLB_ANALITICA_BASE=clb_analitica

# Servidor Ollama (modelo de lenguaje local qwen3:8b)
CLB_OLLAMA_URL=http://localhost:11434

# Servidor de Identidad (Keycloak)
CLB_IDENTIDAD_EMISOR=https://tu-dominio-keycloak/identidad/realms/clb

# Conexión con otros microservicios (contrato interno)
CLB_INVENTARIO_URL=https://tu-dominio-inventario
CLB_CLIENTES_URL=https://tu-dominio-clientes
