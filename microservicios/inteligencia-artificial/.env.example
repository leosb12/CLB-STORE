# Variables que lee fuente/infraestructura/configuracion.py (las vacías son obligatorias). Copiar a .env sin versionarlo.

# Base de datos analítica (PostgreSQL)
CLB_ANALITICA_SERVIDOR=127.0.0.1
CLB_ANALITICA_PUERTO=5432
CLB_ANALITICA_USUARIO=clb_analitica
CLB_ANALITICA_CLAVE=
CLB_ANALITICA_BASE=clb_analitica

# Ollama (modelo de lenguaje local)
CLB_IA_OLLAMA_URL=http://localhost:11434
CLB_IA_MODELO=qwen3:8b
CLB_IA_MODELO_VOZ=small
# Solo si Ollama se publica por Cloudflare Tunnel con Access (Service Auth); se envían como CF-Access-Client-*.
CLB_IA_OLLAMA_ACCESS_ID=
CLB_IA_OLLAMA_ACCESS_CLAVE=

# Identidad (Keycloak): emisor público exacto del token y URL base para JWKS y token de servicio
CLB_IDENTIDAD_EMISOR=https://tu-dominio-keycloak/identidad/realms/clb
CLB_IDENTIDAD_INTERNO=https://tu-dominio-keycloak/identidad
CLB_IDENTIDAD_SECRETO_IA=

# Otros microservicios (rutas /api/v1/interno/* incluidas)
CLB_VENTAS_URL=https://tu-dominio-ventas
CLB_INVENTARIO_URL=https://tu-dominio-inventario
CLB_CLIENTES_URL=https://tu-dominio-clientes
