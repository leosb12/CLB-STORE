# Variables de entorno para el microservicio de Clientes (Fidelización y Notificaciones)

# Entorno: "local" o "produccion"
CLB_ENTORNO=produccion
CLB_CLIENTES_PUERTO_INTERNO=3000
CLB_CLIENTES_TABLA=clb_fidelizacion

# Base de datos DynamoDB (en AWS se usan credenciales IAM; en local el endpoint)
# CLB_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
CLB_DYNAMODB_REGION=us-east-1
# CLB_DYNAMODB_IDENTIFICADOR=
# CLB_DYNAMODB_CLAVE=

# Avisos de pedidos y notificaciones
CLB_NOTIFICACIONES_HABILITADAS=true
CLB_NOTIFICACIONES_CORREO_HABILITADO=true

# Proveedor de correo (Resend)
CLB_RESEND_API_KEY=
CLB_SMTP_REMITENTE=CLB Store <pedidos@clb.carlosgabriel-lobogutierrez.cfd>

# Proveedor de Push (Firebase Cloud Messaging)
# Opción A (campos sueltos):
CLB_FIREBASE_PROJECT_ID=clb-store-cfbc3
CLB_FIREBASE_CLIENT_EMAIL=
CLB_FIREBASE_PRIVATE_KEY=
# Opción B (JSON completo de cuenta de servicio en Base64):
# CLB_FIREBASE_SERVICE_ACCOUNT_BASE64=

# Servidor de Identidad (Keycloak)
CLB_IDENTIDAD_EMISOR=https://tu-dominio-keycloak/identidad/realms/clb
CLB_IDENTIDAD_JWKS=https://tu-dominio-keycloak/identidad/realms/clb/protocol/openid-connect/certs
