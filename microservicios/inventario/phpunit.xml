<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Dominio"><directory>pruebas/Dominio</directory></testsuite>
        <testsuite name="Aplicacion"><directory>pruebas/Aplicacion</directory></testsuite>
        <testsuite name="Integracion"><directory>pruebas/Integracion</directory></testsuite>
        <testsuite name="Http"><directory>pruebas/Http</directory></testsuite>
    </testsuites>
    <source><include><directory>fuente</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <!-- Las pruebas existentes usan el modo local; las de OIDC lo cambian explícitamente. -->
        <env name="CLB_INVENTARIO_ACCESO" value="local" force="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
