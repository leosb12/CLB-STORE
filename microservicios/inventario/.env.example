APP_NAME="CLB Store — Inventario"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=single
LOG_LEVEL=warning
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CLB_MONGO_SERVIDOR=127.0.0.1
# Si se define una URI completa, reemplaza host, puerto y credenciales separados.
CLB_MONGO_URI=
CLB_MONGO_PUERTO=27017
CLB_MONGO_BASE=clb_inventario
CLB_MONGO_AUTENTICACION=clb_inventario
CLB_MONGO_USUARIO=clb_inventario
CLB_MONGO_CLAVE=
CLB_MONGO_COLECCION=productos
CLB_ADMINISTRACION_LOCAL_HABILITADA=false

# Almacenamiento compartido opcional. Vacío conserva el adaptador local.
# Activar en Azure/GCP cuando exista el cliente Keycloak clb-inventario con rol servicio.
CLB_ARCHIVOS_URL=
CLB_ARCHIVOS_URL_TOKEN=
CLB_IDENTIDAD_SECRETO_INVENTARIO=
# En despliegues persistir storage/app/prendas, incluidos comprobantes-s3 y caché.
# Base AWS: https://clientes.leonardoserrate.xyz (HTTPS válido; alternativa por IP https://3.136.183.205).
