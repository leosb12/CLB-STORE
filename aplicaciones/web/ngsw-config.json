{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "clb-aplicacion",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/configuracion.json",
          "/iconos/**",
          "/ilustraciones/**",
          "/prendas/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**"
  ],
  "navigationRequestStrategy": "performance",
  "dataGroups": [
    {
      "name": "clb-probador-modelos",
      "urls": [
        "/probador/modelos/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 10,
        "maxAge": "30d"
      }
    },
    {
      "name": "clb-probador-codigo",
      "urls": [
        "/probador/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "7d",
        "timeout": "3s"
      }
    }
  ]
}
