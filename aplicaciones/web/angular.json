{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "clb-store": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "fuente",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/clb-store",
            "browser": "fuente/principal.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "fuente/index.html",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["fuente/estilos.css"]
          },
          "configurations": {
            "production": {
              "serviceWorker": "ngsw-config.json",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "800kB"
                }
              ]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "clb-store:build:development" },
            "production": { "buildTarget": "clb-store:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
