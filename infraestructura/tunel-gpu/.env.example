# Copiar a .env (no se versiona). No contiene secretos: solo URLs públicas de Keycloak.
# Prueba local (Keycloak del stack local, vía su pasarela):
#   CLB_IDENTIDAD_EMISOR=http://127.0.0.1:18000/identidad/realms/clb
#   CLB_IDENTIDAD_INTERNO=http://host.docker.internal:18000/identidad
# Presentación (Keycloak del compañero): emisor = «iss» exacto de sus tokens; interno = base pública que sirve
#   <interno>/realms/clb/protocol/openid-connect/certs
CLB_IDENTIDAD_EMISOR=
CLB_IDENTIDAD_INTERNO=
