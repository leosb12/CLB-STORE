       "value": "=Bearer {{ $('Token de servicio').first().json.access_token }}"
      }
     ]
    },
    "options": {
     "timeout": 10000
    },
    "sendQuery": true,
    "specifyQuery": "keypair",
    "queryParameters": {
     "parameters": [
      {
       "name": "desde",
       "value": "={{ $('Cursor de avisos').first().json.desde }}"
      },
      {
       "name": "límite",
       "value": "20"
      }
     ]
    }
   }
  },
  {
   "id": "a3000000-0000-4000-8000-000000000005",
   "name": "Lote de avisos",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const { eventos, siguiente } = $input.first().json;\n// Al activarse por primera vez el flujo solo avisa de lo nuevo: los pedidos anteriores ya ocurrieron sin aviso.\nconst datos = $getWorkflowStaticData('global');\ndatos.avisosDesde ??= new Date().toISOString();\nconst desde = new Date(datos.avisosDesde).getTime();\n// Solo identificadores: Clientes busca preferencias, correo y dispositivos del titular; nada personal viaja por n8n.\nconst avisos = eventos.filter((e) => ['pedido_confirmado', 'pedido_cancelado'].includes(e.tipo)\n  && new Date(e.fecha).getTime() >= desde).map((e) => ({\n  evento: `ventas:${e.identificador}`, tipo: e.tipo, cliente: e.datos.identificador_cliente, pedido: e.datos.identificador }));\nreturn [{ json: { eventos: avisos, siguiente } }];"
   }
  },
  {
   "id": "a3000000-0000-4000-8000-000000000006",
   "name": "Registrar en Clientes",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $env.CLB_CLIENTES_URL }}/api/v1/interno/notificaciones/registrar",
    "sendHeaders": true,
    "specifyHeaders": "keypair",
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $('Token de servicio').first().json.access_token }}"
      }
     ]
    },
    "options": {
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     },
     "timeout": 10000
    },
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ eventos: $json.eventos }) }}"
   }
  },
  {
   "id": "a3000000-0000-4000-8000-000000000007",
   "name": "Verificar registro",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1320,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const registrarRechazo = (r) => {\n  const datosRechazos = $getWorkflowStaticData('global');\n  datosRechazos.rechazados = [{ ...r, fecha: new Date().toISOString() },\n    ...(datosRechazos.rechazados ?? []).filter((x) => x.evento !== r.evento)].slice(0, 100);\n};\nconst r = $input.first().json;\n// El cursor solo avanza con el lote ya guardado en Clientes (202). Caída o error temporal: el siguiente ciclo repite el\n// mismo lote y el registro es idempotente por evento. Un rechazo definitivo se registra para revisión sin frenar la cola.\nif (r.statusCode >= 500 || [401, 403, 408, 425, 429].includes(r.statusCode)) throw new Error(`Clientes respondió ${r.statusCode}: se reintentará.`);\nif (r.statusCode !== 202) registrarRechazo({ evento: `avisos#${$('Cursor de avisos').first().json.desde}`, destino: 'Clientes',\n  estado: r.statusCode, motivo: String(r.body?.mensaje ?? '').slice(0, 200) });\nreturn [{ json: { estado: r.statusCode } }];"
   }
  },
  {
   "id": "a3000000-0000-4000-8000-000000000008",
   "name": "Avanzar cursor",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1540,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const datos = $getWorkflowStaticData('global');\ndatos.cursorAvisos = $('Lote de avisos').first().json.siguiente;\nreturn [{ json: { cursor: datos.cursorAvisos } }];"
   }
  },
  {
