# Referencia pública. El servicio real lee /etc/clb/clientes.env por systemd.
# AWS: perfil de operador clb-despliegue; la aplicación utiliza el rol EC2, sin access keys.
CLB_ENTORNO=produccion
CLB_CLIENTES_HOST=127.0.0.1
CLB_CLIENTES_PUERTO_INTERNO=3000
CLB_CLIENTES_TABLA=clb_fidelizacion
CLB_DYNAMODB_REGION=us-east-2
CLB_S3_BUCKET=clb-store-archivos-leonardoserrate
CLB_ARCHIVOS_TABLA=clb_archivos
CLB_CORS_ORIGENES=https://leonardoserrate.xyz,https://tienda.leonardoserrate.xyz
CLB_IDENTIDAD_EMISOR=https://auth.leonardoserrate.xyz/realms/clb
CLB_IDENTIDAD_JWKS=https://auth.leonardoserrate.xyz/realms/clb/protocol/openid-connect/certs
CLB_NOTIFICACIONES_HABILITADAS=false
CLB_NOTIFICACIONES_CORREO_HABILITADO=false

# Configuración para Ventas, IA y n8n en GCP/Azure: consumen REST, nunca DynamoDB directamente.
CLB_CLIENTES_URL=https://clientes.leonardoserrate.xyz
CLB_ARCHIVOS_URL=https://clientes.leonardoserrate.xyz
# Inventario: activar el adaptador S3 solo con identidad de servicio disponible.
CLB_ARCHIVOS_URL_TOKEN=https://auth.leonardoserrate.xyz/realms/clb/protocol/openid-connect/token
# CLB_IDENTIDAD_SECRETO_INVENTARIO: secreto privado de clb-inventario, no versionar.
# Acceso alternativo por IP, también con certificado válido: https://3.136.183.205.
# CLB_TOKEN se obtiene de Keycloak en ejecución; nunca versionarlo.
