{
  "realm": "clb",
  "displayName": "CLB Store",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es"
  ],
  "defaultLocale": "es",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "offlineSessionIdleTimeout": 2592000,
  "passwordPolicy": "length(10) and notUsername",
  "roles": {
    "realm": [
      {
        "name": "cliente",
        "description": "Compra en la tienda web y Android."
      },
      {
        "name": "admin",
        "description": "Administra catálogo, inventario y gestión empresarial."
      },
      {
        "name": "servicio",
        "description": "Identidad de un microservicio para llamadas internas."
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-clb",
        "composite": true,
        "composites": {
          "realm": [
            "cliente",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-clb"
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Identificador del usuario (sub) y momento de autenticación.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "clb-api",
      "description": "Audiencia de las APIs de CLB Store: los servicios rechazan tokens sin ella.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "audiencia-clb-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "clb-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles-de-realm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "nombre de usuario",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "nombre completo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "correo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "offline_access",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "true"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "clb-api",
    "profile",
    "email"
  ],
  "defaultOptionalClientScopes": [
    "offline_access"
  ],
  "clients": [
    {
      "clientId": "clb-web",
      "name": "CLB Store — web (tienda y panel)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:14200/*",
        "http://localhost:14200/*",
        "http://127.0.0.1:4200/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "clb-api",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "clb-android",
      "name": "CLB Store — Android",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "bo.clb.store:/oauth2redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "bo.clb.store:/oauth2redirect"
      },
      "defaultClientScopes": [
        "basic",
        "clb-api",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "clb-ventas",
      "name": "Microservicio de Ventas (orquestador de la SAGA)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "clb-api"
      ]
    },
    {
      "clientId": "clb-ia",
      "name": "Microservicio de IA (ingesta de eventos)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "clb-api"
      ]
    },
    {
      "clientId": "clb-n8n",
      "name": "Automatización n8n (flujos entre servicios)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "clb-api"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-clb-ventas",
      "enabled": true,
      "serviceAccountClientId": "clb-ventas",
      "realmRoles": [
        "servicio"
      ]
    },
    {
      "username": "service-account-clb-ia",
      "enabled": true,
      "serviceAccountClientId": "clb-ia",
      "realmRoles": [
        "servicio"
      ]
    },
    {
      "username": "service-account-clb-n8n",
      "enabled": true,
      "serviceAccountClientId": "clb-n8n",
      "realmRoles": [
        "servicio"
      ]
    }
  ]
}
