CLB_POSTGRES_PUERTO=5432
CLB_POSTGRES_USUARIO=clb_ventas
CLB_POSTGRES_CLAVE=
CLB_MONGO_PUERTO=27017
CLB_MONGO_ADMINISTRADOR=clb_administrador
CLB_MONGO_CLAVE_ADMINISTRADOR=
CLB_MONGO_USUARIO=clb_inventario
CLB_MONGO_CLAVE=
CLB_DYNAMODB_PUERTO=8000
# Credenciales ficticias, válidas exclusivamente para DynamoDB Local.
CLB_DYNAMODB_IDENTIFICADOR=clblocal
CLB_DYNAMODB_CLAVE=clblocalficticia
CLB_DYNAMODB_REGION=us-east-1

# Aplicaciones locales incluidas en el mismo grupo clb-store de Docker Desktop.
CLB_INVENTARIO_PUERTO=18080
CLB_WEB_PUERTO=14200
CLB_VENTAS_PUERTO=18090
CLB_CLIENTES_PUERTO=18091
# Generar una vez: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
CLB_INVENTARIO_CLAVE_APLICACION=
CLB_ADMINISTRACION_LOCAL_HABILITADA=false

# Identidad (Keycloak) y pasarela. Claves solo locales; el script de identidad crea usuarios de demostración con ellas.
CLB_PASARELA_PUERTO=18000
CLB_IDENTIDAD_URL_PUBLICA=http://127.0.0.1:18000/identidad
CLB_IDENTIDAD_ADMINISTRADOR=clb_administrador
CLB_IDENTIDAD_CLAVE_ADMINISTRADOR=
CLB_IDENTIDAD_SECRETO_VENTAS=
CLB_IDENTIDAD_CLAVE_CLIENTE_DEMO=
# true solo en local: crea el cliente clb-demostracion (password grant) para los scripts de demostración.
CLB_IDENTIDAD_DEMOSTRACION=false
CLB_IDENTIDAD_CLAVE_ADMIN_DEMO=

# Modelo de lectura de Inteligencia Artificial (base clb_analitica, usuario propio).
CLB_ANALITICA_CLAVE=
CLB_IDENTIDAD_SECRETO_IA=
# Opcionales: LLM local (Ollama en el host) y modelo de voz. qwen3:4b si falta memoria de GPU.
# CLB_IA_MODELO=qwen3:8b
# CLB_IA_MODELO_VOZ=small

# Automatización n8n (fase 10): cliente Keycloak clb-n8n y clave de cifrado de su base local.
CLB_IDENTIDAD_SECRETO_N8N=
CLB_N8N_CLAVE_CIFRADO=
# CLB_N8N_PUERTO=15678
# Perfil opcional vton: límites de RAM del worker (no son VRAM).
CLB_VTON_RAM=4g
CLB_VTON_RAM_SWAP=5g

# Avisos de pedido (los usa Clientes). Envíos reales solo con true; por defecto se registran como NO_CONFIGURADO.
CLB_NOTIFICACIONES_HABILITADAS=false
# Correo real aparte (además del anterior): solo con destinatarios confirmados. Sin él, el correo queda NO_CONFIGURADO.
CLB_NOTIFICACIONES_CORREO_HABILITADO=false

# Firebase Cloud Messaging (Notificaciones Push)
# Obtenido desde Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave privada
CLB_FIREBASE_PROJECT_ID=clb-store-cfbc3
CLB_FIREBASE_CLIENT_EMAIL=
CLB_FIREBASE_PRIVATE_KEY=
# Alternativa: el contenido completo del JSON codificado en Base64 (recomendado para evitar escapes de saltos de línea):
CLB_FIREBASE_SERVICE_ACCOUNT_BASE64=

# Correo: Clientes usa la API HTTPS de Resend (CLB_RESEND_API_KEY) y CLB_SMTP_REMITENTE como remitente verificado.
# Las variables SMTP restantes no se usan en el código.
CLB_SMTP_HOST=smtp.resend.com
CLB_SMTP_PORT=465
CLB_SMTP_USER=resend
CLB_SMTP_PASS=
CLB_SMTP_REMITENTE=CLB Store <onboarding@resend.dev>
CLB_RESEND_API_KEY=
