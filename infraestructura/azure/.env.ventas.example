# Plantilla sin secretos. El archivo real vive solo en la VM: /srv/clb/.env.ventas (chmod 600). Nunca en Git.
# Variables leídas por microservicios/ventas/src/main/resources/application.properties y compose.ventas.yaml.

CLB_VENTAS_DOMINIO=ventas.leonardoserrate.xyz

# PostgreSQL privado: generar en la VM con  openssl rand -hex 24  (dos claves distintas)
CLB_POSTGRES_ADMIN_CLAVE=
CLB_POSTGRES_CLAVE=

# Keycloak (dato del compañero): emisor exacto del token (…/realms/clb) y URL base para JWKS y token de servicio
CLB_IDENTIDAD_EMISOR=
CLB_IDENTIDAD_INTERNO=
# Secreto del cliente clb-ventas (rol servicio). Se recibe por canal seguro.
CLB_IDENTIDAD_SECRETO_VENTAS=

# Bases de Inventario y Clientes con /api/v1/interno/* accesible desde la IP de Azure (dato del compañero)
CLB_INVENTARIO_URL=
CLB_CLIENTES_URL=

# IP de salida de IA y n8n (CIDR, separadas por espacio) autorizadas para /api/v1/interno/*
CLB_VENTAS_ORIGENES_INTERNOS=

# --- Inteligencia Artificial (misma VM) ---
CLB_IA_DOMINIO=ia.leonardoserrate.xyz
# PostgreSQL clb_analitica privado: generar en la VM con  openssl rand -hex 24  (dos claves distintas)
CLB_ANALITICA_ADMIN_CLAVE=
CLB_ANALITICA_CLAVE=
# Secreto del cliente clb-ia (rol servicio) del Keycloak del compañero. Por canal seguro.
CLB_IDENTIDAD_SECRETO_IA=
# Token de servicio Cloudflare Access de Ollama (archivo privado del integrante, nunca en Git)
CLB_IA_OLLAMA_ACCESS_ID=
CLB_IA_OLLAMA_ACCESS_CLAVE=
# IP de salida de n8n (CIDR) autorizada para /api/v1/interno/notificaciones de IA
CLB_IA_ORIGENES_INTERNOS=
